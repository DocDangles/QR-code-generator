# Local dev works with none of these set (embedded database, sign-in links print in the terminal).
# For a real deployment see README.md, "Deploy a client on Railway".

DATABASE_URL=                      # unset = embedded PGlite in ~/.cache/e-suite/pglite
APP_URL=https://qr.example.org     # the app's own address (used in sign-in emails)
REDIRECT_DOMAIN=go.example.org     # the domain printed on codes; also enables host gating
FALLBACK_URL=https://example.org

SESSION_SECRET=change-me-to-a-long-random-string
VISITOR_SALT_SECRET=change-me-to-another-long-random-string
JOB_SECRET=change-me-to-a-third-long-random-string

RESEND_API_KEY=
MAIL_FROM=Example QR <qr@your-verified-domain>

RETENTION_MONTHS=13

# Seed (required against a real database; see README step 3):
# CLIENT_NAME, CLIENT_SLUG, REDIRECT_DOMAIN, FALLBACK_URL, ADMIN_EMAIL, NOTIFY_EMAIL, CLIENT_STAFF_EMAILS, TIMEZONE
